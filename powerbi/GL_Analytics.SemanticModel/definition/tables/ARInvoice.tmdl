		sourceColumn: status

		annotation SummarizationSetBy = Automatic

	/// Days past due date at 31 Mar 2026 for open invoices; blank for paid ones.
	column days_overdue = IF ( ARInvoice[status] = "Open", INT ( DATE ( 2026, 3, 31 ) - ARInvoice[due_date] ) )
		dataType: int64
		formatString: 0
		lineageTag: 81013001-05ee-49d1-ba68-024dde6afa1d
		summarizeBy: none

	/// Ageing bucket at 31 Mar 2026 (open invoices only).
	column ageing_bucket =
			VAR d = ARInvoice[days_overdue]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( d ), BLANK (),
			        d <= 0, "Not due",
			        d <= 30, "1-30",
			        d <= 60, "31-60",
			        d <= 90, "61-90",
			        d <= 180, "91-180",
			        "Over 180"
			    )
		dataType: string
		lineageTag: a7114b42-5784-4906-9dfd-a7d3c1a13fb7
		summarizeBy: none
		sortByColumn: ageing_sort

	column ageing_sort =
			VAR d = ARInvoice[days_overdue]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( d ), BLANK (),
			        d <= 0, 1,
			        d <= 30, 2,
			        d <= 60, 3,
			        d <= 90, 4,
			        d <= 180, 5,
			        6
			    )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b8fb3b22-7509-4bc9-ba93-d6702e012f4d
		summarizeBy: none

	/// Days from invoice to payment for paid invoices.
	column days_to_pay = IF ( NOT ISBLANK ( ARInvoice[paid_date] ), INT ( ARInvoice[paid_date] - ARInvoice[invoice_date] ) )
		dataType: int64
		formatString: 0
		lineageTag: f3e90e64-7ac3-406f-8a97-5ac620ca0834
		summarizeBy: none

