table 'Measures (2)'
	lineageTag: 797335ea-2409-44e1-8a02-5b1895ab7886

	measure 'GL Amount' = SUM ( GL[amount] )
		lineageTag: 30253601-53cf-4d23-a7f3-ece0c12d494b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Revenue = ```
			- CALCULATE ( [GL Amount], Account[account_class] = "Revenue" )
			
			```
		formatString: 0
		lineageTag: 62e94f47-7f02-4cae-8c32-f9582ba081d0

		annotation PBI_FormatHint = {"isDecimal":true}

	measure COGS = ```
			CALCULATE ( [GL Amount], Account[account_class] = "COGS" )
			
			```
		lineageTag: eb392785-76e0-4b46-a5b8-19f0c4c05e59

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Profit' = ```
			[Revenue] - [COGS]
			
			```
		lineageTag: 81bd13b2-4d91-4ebb-98e2-e55cbcf3dcd0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Opex = CALCULATE ( [GL Amount], Account[account_class] = "Operating Expenses" )
		lineageTag: 6b2f4129-e2ee-4f81-852e-bf64380af32d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure EBITDA = ```
			[Gross Profit] - [Opex]
			
			```
		lineageTag: f7020f5e-5158-4f3e-8c0f-f80a23f89485

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Depreciation = ```
			CALCULATE ( [GL Amount], Account[account_class] = "Depreciation" )
			
			```
		lineageTag: 6a6ffec9-5564-4875-9016-8629f80ade7e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure EBIT = ```
			[EBITDA] - [Depreciation]
			
			```
		lineageTag: 00bbf59c-5a61-45bd-b02a-b01d36305056

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Finance Costs' = ```
			CALCULATE ( [GL Amount], Account[account_class] = "Finance Costs" )
			
			```
		lineageTag: b763260e-64e6-4c63-ab34-d3c5976a9582

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PBT = ```
